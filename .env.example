# .env.local —— 本地运行配置示例
# 复制为 .env.local 后填入实际值

# ── 大模型（阿里百炼 qwen-plus）──
# OPENAI_API_KEY=sk-xxxx  （或直接在 shell 里 export 这个环境变量）
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus

# ── Milvus ──
# MILVUS_URI=http://localhost:19531
# MILVUS_COLLECTION=medical_guidelines

# ── 本地 Embedding（bge-m3）──
# EMBEDDING_MODEL_PATH=./models/bge-m3
# EMBEDDING_DIM=1024
